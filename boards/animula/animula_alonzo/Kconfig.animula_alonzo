config BOARD_ANIMULA_ALONZO
	select SOC_STM32F411XE
	# The bootloader bit-bangs SWD on PA2/PA3 (USART2) and must re-apply
	# USART2's pinctrl state to restore the BLE UART after programming.
	select PINCTRL_NON_STATIC

config ALONZO_BOOTLOADER_SIZE
	hex "Reserved bootloader flash size (bytes)"
	default 0x20000
	help
	  Flash size reserved for the Maker Bootloader. The application is
	  linked immediately after it: APP_START = FLASH_BASE + this size.

	  Must be sector-aligned on the STM32F411CEU6 (S0..S3 = 16 KB each,
	  S4 = 64 KB, S5..S7 = 128 KB each). Valid values are:
	    0x04000 (16 KB)   0x08000 (32 KB)   0x0C000 (48 KB)
	    0x10000 (64 KB)   0x20000 (128 KB)  0x40000 (256 KB)
	    0x60000 (384 KB)  0x80000 (512 KB)

	  Keep this in sync with CONFIG_FLASH_LOAD_SIZE in the bootloader's
	  prj.conf (and CONFIG_FLASH_LOAD_OFFSET in the application); a
	  mismatch is caught by a build-time assertion in memory_layout.h.

